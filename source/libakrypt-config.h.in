#ifndef    __LIBAKRYPT_CONFIG_H__
#define    __LIBAKRYPT_CONFIG_H__

/* ----------------------------------------------------------------------------------------------- */
/*  Определение базовых параметров                                                                 */
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Информация о версии библиотеки */
 #define AK_VERSION ("@FULL_VERSION@")
/*! @brief Информация о компиляторе */
 #define AK_COMPILER_NAME ("@CMAKE_C_COMPILER_ID@")
/*! @brief Информация о версии компиляторя */
 #define AK_COMPILER_VERSION ("@CMAKE_C_COMPILER_VERSION@")
/*! @brief Определение порядка следования байт (возможные значения: LITTLE_ENDIAN или BIG_ENDIAN)  */
 #define AK_ENDIANNESS ("@CMAKE_C_BYTE_ORDER@")
/*! @brief Размер статического буффера для вывода сообщений библиотеки
    Для встраиваемых систем это значение может быть уменьшено до значений 128 или 256              */
 #define AK_DEFAULT_STATIC_BUFFER_SIZE 1024

/* ----------------------------------------------------------------------------------------------- */
/*  Определение расширений процессора, влияющих на реализацию криптографичских преобразований      */
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Разрешение на использование процессорной команды mulqdq                                 */
 #cmakedefine AK_HAVE_BUILTIN_MULQ_GCC
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Разрешение на использование процессорной команды clmulepi64_si128                       */
 #cmakedefine AK_HAVE_BUILTIN_CLMULEPI64
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Разрешение на использование процессорных команд mm256_srli_epi64, mm256_sll_epi64       */
 #cmakedefine AK_HAVE_BUILTIN_MM256_SLL

/* ----------------------------------------------------------------------------------------------- */
/*  Подключение заголовков стандартной библиотеки языка Си, влияющих на функции из ak_tools.c      */
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Добавляем поддержку NULL и size_t                                                       */
 #cmakedefine AK_HAVE_STDDEF_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Добавляем поддержку типов uint32_t, uint64_t и т.д.                                     */
 #cmakedefine AK_HAVE_STDINT_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Добавляем поддержку функций memcpy(), memset(), strcmp() и др.                          */
 #cmakedefine AK_HAVE_STRING_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Добавляем поддержку функций с переменным числом аргументов                              */
 #cmakedefine AK_HAVE_STDARG_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Добавляем поддержку стандартного ввода/вывода и функции vsprintf()                      */
 #cmakedefine AK_HAVE_STDIO_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Добавляем поддержку маркировки функций с переменным числом аргументов                   */
 #cmakedefine AK_HAVE_ATTRIBUTE_FORMAT_PRINTF
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Добавляем поддержку функций getpid()                                                    */
 #cmakedefine AK_HAVE_UNISTD_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Добавляем поддержку демона syslog или его аналогов                                      */
 #cmakedefine AK_HAVE_SYSLOG_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Добавляем поддержку операционной системы Windows                                        */
 #cmakedefine AK_HAVE_WINDOWS_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Определяем случай, когда можно применять функцию ak_snprintf                            */
 #ifdef AK_HAVE_STDARG_H
  #ifdef AK_HAVE_STDIO_H
   #define AK_HAVE_SNPRINTF
  #endif
 #endif

