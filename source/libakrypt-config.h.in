#ifndef    __LIBAKRYPT_CONFIG_H__
#define    __LIBAKRYPT_CONFIG_H__

/* ----------------------------------------------------------------------------------------------- */
/*  Определение базовых параметров                                                                 */
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Информация о версии библиотеки                                                          */
 #define AK_VERSION ("@FULL_VERSION@")
/*! @brief Информация о компиляторе                                                                */
 #define AK_COMPILER_NAME ("@CMAKE_C_COMPILER_ID@")
/*! @brief Информация о версии компиляторя                                                         */
 #define AK_COMPILER_VERSION ("@CMAKE_C_COMPILER_VERSION@")
/*! @brief Определение порядка следования байт
   (возможные значения: AK_LITTLE_ENDIAN или AK_BIG_ENDIAN)                                        */
 #define AK_@CMAKE_C_BYTE_ORDER@
/*! @brief Размер статического буффера для вывода сообщений библиотеки
    Для встраиваемых систем это значение может быть уменьшено до значений 128 или 256              */
 #define AK_DEFAULT_STATIC_BUFFER_SIZE 1024

/* ----------------------------------------------------------------------------------------------- */
/*  Определение расширений процессора, влияющих на реализацию криптографичских преобразований      */
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Разрешение на использование процессорной команды mulqdq                                 */
 #cmakedefine AK_HAVE_BUILTIN_MULQ_GCC
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Разрешение на использование процессорной команды clmulepi64_si128                       */
 #cmakedefine AK_HAVE_BUILTIN_CLMULEPI64
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Разрешение на использование процессорных команд mm256_srli_epi64, mm256_sll_epi64       */
 #cmakedefine AK_HAVE_BUILTIN_MM256_SLL

/* ----------------------------------------------------------------------------------------------- */
/*  Определение значений криптографических параметров библиотеки. Модифицируйте значения           */
/*  данных параметров аккуратно и только в том случае, если Вы понимаете зачем.                    */
/*  В случае, если параметры не определены, при сборке используются значения по-умолчанию          */
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Параметр `pdkdf2_iteration_count` определяет количество циклов, используемых в алгоритме
    выработки ключа из пароля (чем больше данное значение, тем медленнее происходит генерация ключа
    и тем сложнее реализуется перебор пароля).
    Значение параметра должно быть не менее 1000, и не более 32000                                 */
 #define AK_OPTION_PDKDF2_ITERATION_COUNT                 (2000)

/*! @brief Параметр `hmac_key_count_resource` определяет количество использований ключа
    выработки имитовставки для алгоритмов семейства hmac (количество сообщений,
    для которых может быть подсчитана имитовставка). Данное значение должно
    быть не менее 1024 и не более 2^{31}-1. По-умолчанию, равняется 2^{20} = 1048576.              */
 #define AK_OPTION_HMAC_KEY_COUNT_RESOURCE                (1048576)

/*! @brief Параметр `magma_cipher_resource` устанавливает максимальное количество блоков,
    зашифровываемых и расшифровываемых на одном ключе для алгоритма Магма (ГОСТ Р 34.12 - 2015),
    рекомендуемые к использованию значения указанного параметра приводятся
    в рекомендациях по стандартизации Р 1323565.1.005-2017 и Р 1323565.1.035-2021.

    Общий объем обрабатываемых данных (в мегабайтах) определяется по формуле
    @code
      ( 8 * magma_cipher_resource ) / 1048576
    @endcode
    Для объема данных в 256 Мб определяется следующее значение параметра (2^25 блоков).            */
 #define AK_OPTION_MAGMA_CIPHER_RESOURCE                  (33554432)

/*! @brief Параметр `kuznechik_cipher_resource` устанавливает максимальное количество блоков,
    зашифровываемых и расшифровываемых на одном ключе для алгоритма Кузнечик (ГОСТ Р 34.12-2015),
    рекомендуемые к использованию значения указанного параметра приводятся
    в рекомендациях по стандартизации Р 1323565.1.005-2017 и Р 1323565.1.035-2021.

    Общий объем обрабатываемых данных (в мегабайтах) определяется по формуле
    @code
      ( 16 * kuznechik_cipher_resource ) / 1048576
    @endcode
    Для объема данных в 4096 Мб определяется следующее значение параметра (2^28 блоков)            */
 #define AK_OPTION_KUZNECHIK_CIPHER_RESOURCE              (268435456)

/*! @brief Параметр `acpkm_message_count` определяет максимальное количество сообщений или файлов,
    которые могут быть зашифрованы на одном ключе в режиме acpkm.
    Величина параметра, установленная по-умолчанию, определяется в рекомендациях
    по стандартизации Р 1323565.1.017-2018.                                                        */
 #define AK_OPTION_ACPKM_MESSAGE_COUNT                    (4096)

/*! @brief Параметр `acpkm_section_magma_block_count` определяет количество блоков, после
    шифрования которых будет запущена процедура выработки следующего производного ключа
    для блочного шифра Магма. Для данного параметра должно быть выполнено равенство
    @code
      acpkm_section_magma_block_count * acpkm_message_count = magma_cipher_resource
    @endcode                                                                                       */
 #define AK_OPTION_ACPKM_SECTION_MAGMA_BLOCK_COUNT        (128)

/*! @brief Параметр `acpkm_section_kuznechik_block_count` определяет количество блоков, после
    шифрования которых будет запущена процедура выработки следующего производного ключа
    для блочного шифра Кузнечик. Для данного параметра должно быть выполнено равенство
    @code
       acpkm_section_kuznechik_block_count * ackpm_message_count = kuznechik_cipher_resource
    @endcode                                                                                       */
 #define AK_OPTION_ACPKM_SECTION_KUZNECHIK_BLOCK_COUNT    (512)

/*! @brief Параметр `digital_signature_count_resource` определяет количество использований ключа
    электронной подписи. Данное значение должно быть не менее 1024 и не более 2^{31}-1.
    Значение по-умолчанию равно 2^{16} = 65536.                                                    */
 #define AK_OPTION_DIGITAL_SIGNATURE_COUNT_RESOURCE       (65536)

/*! @brief Параметр `use_additional_algorithm_check_context` включает дополнительную проверку
    корректной работы криптографического алгоритма в момент создания криптографического контекста,
    т.о. тест корректной работы алгоритма реализуется перед каждым его применением.
    Значение параметра 1 определяет выполнение проверки, значение 0 - отсутствие проверки.         */
 #define AK_OPTION_USE_ADDITIONAL_ALGORITHM_CHECK_CONTEXT (0)

/*! @brief Параметр `openssl_compability` предназначен для получения результатов вычисления
    ряда криптографических алгоритмов, совпадающих с теми, что вырабатывает библиотека openssl.
    Совместимость с библиотекой openssl является опциональной, поскольку содержащаяся в
    openssl реализация не имеет строгого соответствия ГОСТ Р 34.12-2015 со всеми вытекающими
    последствиями.
    Значение параметра 1 определяет совместимость, любое другое значение - нет.                    */
 #define AK_OPTION_OPENSSL_COMPABILITY                    (0)

/*! @brief Флаг использования цветового выделения при выводе сообщений библиотеки
    значение параметра 1 разрешает исопльзование цвета, значение 0 запрещает.
    Для операционной системы Windows значение флага игнорируется.                                  */
 #define AK_OPTION_USE_COLOR_OUTPUT                       (1)

/* ----------------------------------------------------------------------------------------------- */
/*! @brief Определение этого макроса отключает быструю табличную реализацию семейства
    функций хеширования Стрибог и подключает более медленную, но использующую существенно
    меньший объем статической памяти.                                                              */
 #undef AK_HAVE_SLOW_HASH

/* ----------------------------------------------------------------------------------------------- */
/*! @brief Подключаем поддержку идентификаторов криптографических механизмов                       */
 #undef AK_HAVE_OID

/* ----------------------------------------------------------------------------------------------- */
/*  Подключение заголовков стандартной библиотеки языка Си, влияющих на функции из ak_tools.c      */
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Подключаем поддержку NULL и size_t                                                      */
 #cmakedefine AK_HAVE_STDDEF_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Подключаем поддержку типов uint32_t, uint64_t и т.д.                                    */
 #cmakedefine AK_HAVE_STDINT_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Подключаем поддержку функций memcpy(), memset(), strcmp() и др.                         */
 #cmakedefine AK_HAVE_STRING_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Подключаем поддержку функций с переменным числом аргументов                             */
 #cmakedefine AK_HAVE_STDARG_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Подключаем поддержку стандартного ввода/вывода и функции vsprintf()                     */
 #cmakedefine AK_HAVE_STDIO_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Подключаем поддержку malloc() и free()                                                  */
 #cmakedefine AK_HAVE_STDLIB_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Подключаем поддержку маркировки функций с переменным числом аргументов                  */
 #cmakedefine AK_HAVE_ATTRIBUTE_FORMAT_PRINTF
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Подключаем поддержку функции getpid()                                                   */
 #cmakedefine AK_HAVE_UNISTD_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Подключаем поддержку демона syslog или его аналогов                                     */
 #cmakedefine AK_HAVE_SYSLOG_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Подключаем поддержку операционной системы Windows                                       */
 #cmakedefine AK_HAVE_WINDOWS_H
/* ----------------------------------------------------------------------------------------------- */
/*! @brief Определяем случай, когда можно применять функцию ak_snprintf                            */
 #ifdef AK_HAVE_STDARG_H
  #ifdef AK_HAVE_STDIO_H
   #define AK_HAVE_SNPRINTF
  #endif
 #endif

